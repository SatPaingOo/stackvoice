# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# runtime
config/backups/
logs/
*.log

# env & secrets
.env
.env.*
!.env.example

# AI tool working folders
.claude/
.cursor/
.zcode/
.windsurf/
.aider*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# test output
coverage/

# end-to-end test output
test-results/
playwright-report/
blob-report/

# server-side secrets such as API keys, never committed
config/secrets.yml
# what the owner has been told, for "what's new"; state, not config
config/seen.json
config/seen.json.tmp
# OAuth clients that registered themselves, and their refresh tokens (hashed)
config/oauth.json
config/oauth.json.tmp
# Your own data files for file sources; never pushed by accident.
/data/
tests/e2e/.work/
tests/e2e/.data/
