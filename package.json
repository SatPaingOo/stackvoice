{
  "name": "stackvoice",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted, config-driven MCP server that turns your own data projects into tools an AI assistant can call.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "stackvoice": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "dev": "npm run build:client && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "stackvoice": "tsx src/cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
