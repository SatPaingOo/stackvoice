{
  "name": "stackvoice",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted MCP server that turns your own feeds, APIs, spreadsheets, repositories and files into tools a voice assistant can call.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "stackvoice": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "dev": "npm run build:client && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "stackvoice": "tsx src/cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
